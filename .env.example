# Copy to .env and fill in. Never commit .env.
# docker compose reads this file; the backend also reads it when run from backend/.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database -------------------------------------------------------------------
# Owner role (runs migrations). The app itself connects as the least-privilege
# role regtrace_app, which is subject to row-level security.
POSTGRES_USER=regtrace
POSTGRES_PASSWORD=regtrace
POSTGRES_DB=regtrace
APP_DB_PASSWORD=regtrace_app
# Used only when running the backend on the host (docker compose overrides these):
DATABASE_URL=postgresql+asyncpg://regtrace_app:regtrace_app@localhost:5432/regtrace
MIGRATION_DATABASE_URL=postgresql+asyncpg://regtrace:regtrace@localhost:5432/regtrace

# --- Security -------------------------------------------------------------------
# Change both for anything beyond a local demo.
JWT_SECRET=change-me-to-a-long-random-string-change-me
SEED_PASSWORD=RegTrace!2026

# --- Free LLM providers -----------------------------------------------------------
# Gemini: https://aistudio.google.com/apikey (no credit card)
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# 0 turns off 2.5 Flash "thinking" to save output quota; leave empty for model default.
GEMINI_THINKING_BUDGET=

# Groq: https://console.groq.com/keys (no credit card)
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Ollama (optional, local, unlimited): install, then `ollama pull qwen2.5:7b`
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=qwen2.5:3b

# Fallback order per tier (JSON list).
LLM_REASONING_CHAIN=["gemini","groq","ollama"]
LLM_FAST_CHAIN=["gemini","groq","ollama"]

# Optional quota overrides (JSON). Keys are "<provider>:<model>".
# LLM_RATE_LIMITS={"gemini:gemini-2.5-flash":{"rpm":10,"rpd":250,"tpm":250000}}

# Optional: Slack/Teams-compatible webhook for impact-report notifications.
NOTIFY_WEBHOOK_URL=
